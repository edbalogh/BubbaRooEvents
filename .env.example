# Database
DATABASE_URL=postgresql+asyncpg://bubbaroo:bubbaroo@localhost:5432/bubbaroo_events
DATABASE_URL_SYNC=postgresql://bubbaroo:bubbaroo@localhost:5432/bubbaroo_events

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ticketmaster API
TICKETMASTER_API_KEY=your-ticketmaster-api-key

# SeatGeek API (Phase 4)
SEATGEEK_CLIENT_ID=your-seatgeek-client-id
SEATGEEK_CLIENT_SECRET=your-seatgeek-client-secret

# Twilio SMS (Phase 3)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email - Resend (Phase 3)
RESEND_API_KEY=your-resend-api-key

# Claude API (Phase 4)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Firebase (Phase 3)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# App Settings
APP_ENV=development
USE_MOCK_DATA=true
